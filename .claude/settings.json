{
  "enabledMcpjsonServers": ["lean-lsp"],
  "permissions": {
    "allow": [
      "mcp__lean-lsp",
      "Bash(lake build*)",
      "Bash(lax build*)",
      "Bash(lake env*)",
      "Bash(rg *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
