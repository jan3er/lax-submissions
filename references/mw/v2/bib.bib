	title = {Handle-rewriting hypergraph grammars},
	volume = {46},
	year = {1993},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/002200009390004G},
	bdsk-url-2 = {https://doi.org/10.1016/0022-0000(93)90004-G}}

